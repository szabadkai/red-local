; RED, boss 3: Rowan the Huntsman. A duel with a frightened man, not a monster.
; D minor march: snare rolls, a fanfare that keeps bracing itself. His meter is Resolve,
; so the second half lifts toward F major twice and falls back to A each time.
; The Wolf boss later steals this fanfare (bars 13-14 there).
;   sid1  kick, snare rolls and bass on one voice
;   sid2  chord arpeggios
;   sid3  fanfare
tempo 138
bars 16

inst kick  wave=n,p arp=36,19,12,7,3,0,-3,-5,-7,-9 pw=50 adsr=0,8,0,0
inst snare wave=n,n,p,n arp=31,31,5,29,27 pw=50 adsr=0,10,0,0
inst bass  wave=p pw=15-60/1.5 adsr=0,10,10,2 filter=lp cut=250-1800/25 res=0.8
inst arp   wave=p arp=12,0 pw=10-45/1 adsr=0,12,6,3
inst fan   wave=s,p pw=40-55/0.8 vib=0.15 adsr=0,12,12,4

$k: @kick v15 o2 c8
$s: @snare v12 o3 g8
$r: @snare v8 o3 g
$b: @bass v13 o2

; ---- sid1 (l16): march bar, and the same bar ending in a roll
$dm:  [$k $b >d d< $s $b >d d<]2 |
$dmr: $k $b >d d< $s $b >d d< $k $b >d d< $r $r $r $r |
$bb:  [$k $b b- b- $s $b b- b-]2 |
$c:   [$k $b >c c< $s $b >c c<]2 |
$gm:  [$k $b g g $s $b g g]2 |
$f:   [$k $b f f $s $b f f]2 |
$a:   [$k $b a a $s $b a a]2 |
$ar:  $k $b a a $s $b a a $k $b a a $r $r $r $r |

sid1: l16 q7
sid1: $dm $dmr $bb $c $dm $dmr $gm $ar
sid1: $f $c $dm $a $bb $c $dm $ar

; ---- sid2: straight eighths, then 3+3+2
$p: @arp v9 o4
$2dm: $p [{dfa}8]8 |
$2bb: $p [{dfb-}8]8 |
$2c:  $p [{eg>c}8]8 |
$2gm: $p [{dgb-}8]8 |
$2a:  $p [{c#ea}8]8 |
$3f:  $p [{fa>c}8. {fa>c}8. {fa>c}8]2 |
$3c:  $p [{eg>c}8. {eg>c}8. {eg>c}8]2 |
$3dm: $p [{dfa}8. {dfa}8. {dfa}8]2 |
$3a:  $p [{c#ea}8. {c#ea}8. {c#ea}8]2 |
$3bb: $p [{dfb-}8. {dfb-}8. {dfb-}8]2 |

sid2: q6
sid2: $2dm $2dm $2bb $2c $2dm $2dm $2gm $2a
sid2: $3f $3c $3dm $3a $3bb $3c $3dm $3a

; ---- sid3
sid3: @fan v12 o4 l8 q7
sid3: d4 d a4 a >d4< | >f4 e d c# d e4< | >d4 d f4 f b-4< | >g4 e c e g4.< |
sid3: d4 d a4 a >d4< | >f4 e d f a4 g< | >b-4 a g4 d g4< | >e4 c# <a4 >e a4< |
sid3: >c4. <a >f2< | >e4. c g2< | >f4 e d4 <a >d4< | >c#4 e4 a2< |
sid3: >d4. <b- >f2< | >e4. c g4 >c4<< | >a4 g f e4 d4< | >e2 c#4. r< |
