; RED, boss 1: the Briar Hart. A forest guardian caught in thorns and an iron trap.
; E minor, fast, but noble rather than evil: a hunting-horn call over a gallop.
; First half is the charge. In the second half the thorns root it in place: the gallop
; stops, the bass erupts upward in arpeggios, and the horn plays Red's theme in minor.
;   sid1  kick, snare and galloping bass on one voice
;   sid2  chord arpeggios, then a shimmer of thorns
;   sid3  horn
tempo 152
bars 16

inst kick  wave=n,p arp=36,19,12,7,3,0,-3,-5,-7,-9 pw=50 adsr=0,8,0,0
inst snare wave=n,n,p,n arp=31,31,5,29,27 pw=50 adsr=0,10,0,0
inst bass  wave=p pw=15-60/1.5 adsr=0,10,10,2 filter=lp cut=250-1800/25 res=0.8
inst arp   wave=p arp=12,0 pw=10-45/1 adsr=0,12,6,3
inst thorn wave=p pw=8-30/2 adsr=6,0,12,6 filter=bp cut=600-3000/40 res=0.6
inst horn  wave=s vib=0.15 adsr=2,10,11,4 filter=lp cut=2200 res=0.3

$k: @kick v13 o2 c8
$s: @snare v12 o3 g8
$b: @bass v10 o2

; ---- sid1 (l16): gallop = drum eighth + two bass sixteenths
$1em: [$k $b e e $s $b e e]2 |
$1c:  [$k $b >c c< $s $b >c c<]2 |
$1d:  [$k $b >d d< $s $b >d d<]2 |
$1b:  [$k $b b b $s $b b b]2 |
; rooted: kick, bass climbs the chord, snare, bass falls back
$2am: $k $b a8 >c8 e8< $s $b >e8 c8< a8 |
$2em: $k $b e8 g8 b8 $s $b b8 g8 e8 |
$2f:  $k $b f8 a8 >c8< $s $b >c8< a8 f8 |
$2b:  $k $b b8 >d#8 f#8< $s $b >f#8 d#8< b8 |

sid1: l16 q7
sid1: $1em $1em $1c $1d $1em $1em $1c $1b
sid1: $2am $2am $2em $2em $2f $2f $2b $2b

; ---- sid2
$a: @arp v10 o4
$t: @thorn v9 o3
$3em: $a [{egb}8. {egb}8. {egb}8]2 |
$3c:  $a [{eg>c}8. {eg>c}8. {eg>c}8]2 |
$3d:  $a [{f#a>d}8. {f#a>d}8. {f#a>d}8]2 |
$3b:  $a [{f#b>d#}8. {f#b>d#}8. {f#b>d#}8]2 |
$4am: $t {a>ce}1 |
$4em: $t {gb>e}1 |
$4f:  $t {a>cf}1 |
$4b:  $t {b>d#f#}1 |

sid2: q6
sid2: $3em $3em $3c $3d $3em $3em $3c $3b
sid2: q8 $4am $4am $4em $4em $4f $4f $4b $4b

; ---- sid3: the horn call, then Red's theme in minor
sid3: @horn v15 o4 l8 q7
sid3: e4. b >e4.< b | >g4 f# e d e <b4 | >c4. <g >e4. c< | >d4 f# a f#4 d4< |
sid3: e4. b >e4.< b | >g4 f# e g a b4< | >c4 e g e4 c4< | b4 >d# f# b2< |
sid3: a4 >c e f4 e c< | b4 >e c< b4. a | e4 g b >e4 d <b | b2. r4 |
sid3: >c4 <a >c f4 e c< | >d4 c <a >c4. <a | b4 >d# f# a4 f# d#< | >f#2 <b4. r |
